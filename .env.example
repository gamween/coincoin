# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# ── ZeroDev (smart account EIP-7702 + bundler/paymaster) ── Arbitrum Sepolia (chain 421614)
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/421614
ZERODEV_PAYMASTER_RPC=https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/421614
ZERODEV_PASSKEY_URL=https://passkeys.zerodev.app/api/v3/<PROJECT_ID>

# ── Alchemy RPC ──
ALCHEMY_API_KEY=
ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>

# ── Robinhood Chain testnet (chain 46630) ──
ALCHEMY_RH_API_KEY=
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc

# ── Defimon (live threat feed) ── optional; empty = locally simulated feed
DEFIMON_WS_KEY=
DEFIMON_WS_URL=

# ── Deployment key (disposable dev wallet) ──
DEPLOYER_PRIVATE_KEY=

# ── End-to-end demo (disposable dev wallets + addresses printed by SetupDemo) ──
VICTIM_PRIVATE_KEY=
VICTIM_ADDRESS=
KEEPER_PRIVATE_KEY=
DEMO_TOKEN=
DEMO_PROTO=
DEMO_VAULT=
# Optional: Aave-V3-shaped pool holding a deposited position to auto-exit on threat.
# Set to the MockAavePool address printed by SetupDemo to demo the DeFi-position exit.
DEMO_AAVE_POOL=

# ── Phase 5: target chain + on-chain detection ──
# robinhood (default, chain 46630) | arbitrumSepolia
CHAIN=robinhood
# GuardianModule impl on the target chain (empty => fallback to Arb Sepolia constant)
GUARDIAN_IMPL=
