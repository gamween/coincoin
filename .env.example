# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# ── RPC ──
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Arbitrum One (mainnet) — only for the real-Aave fork test:
#   ARBITRUM_ONE_RPC=... forge test --match-contract AaveRealFork
ARBITRUM_ONE_RPC=

# ── Keys (disposable dev wallets) ──
DEPLOYER_PRIVATE_KEY=
VICTIM_PRIVATE_KEY=
VICTIM_ADDRESS=
KEEPER_PRIVATE_KEY=

# ── Demo addresses (printed by SetupDemo) ──
DEMO_TOKEN=
DEMO_PROTO=
DEMO_VAULT=
# Optional: MockAavePool address — set it to exercise the DeFi-position exit in the demo.
DEMO_AAVE_POOL=

# ── Target chain ──
CHAIN=robinhood            # robinhood (chain 46630) | arbitrumSepolia
GUARDIAN_IMPL=             # required: GuardianModule impl on the target chain (printed by DeployGuardian)
RULES_ENGINE=              # RulesEngineV1 (printed by DeployRules); also set VITE_RULES_ENGINE in site/.env
