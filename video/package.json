{
  "name": "coincoin-video",
  "version": "1.0.0",
  "private": true,
  "description": "Pitch + demo videos for coincoin (Remotion).",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Pitch out/pitch.mp4 && remotion render Demo out/demo.mp4",
    "render:pitch": "remotion render Pitch out/pitch.mp4",
    "render:demo": "remotion render Demo out/demo.mp4",
    "still": "remotion still Pitch out/pitch-still.png --frame=120",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.477",
    "@remotion/google-fonts": "4.0.477",
    "@remotion/media-utils": "4.0.477",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.477"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
